<krpano>

	<!--
		Primary navigation — every destination is a painted object in the
		room. Coordinates were measured off rendered views (see
		preview.html; screen-to-angle math in scripts/make-patches.py
		docstring). Distorted-hotspot pixel width = 2000 * tan(deg/2).

		The plate already contains the objects, so nav hotspots are
		INVISIBLE glow silhouettes (alpha 0) that sit exactly over the
		painted art and only fade in as a soft warm aura on hover — no
		double-drawn props, nothing that reads as a button.

		The mail slot is the one visible overlay prop: the painted door has
		no slot, so the sheet prop is additive.
	-->

	<style name="navspot"
		type="image" keep="true" group="nav"
		distorted="true" alpha="0.0" zorder="10"
		onover="nav_over();" onout="nav_out();" onclick="nav_go();"
		handcursor="true"
	/>

	<!-- Record crates (ROCK/INDIE + NEW ARRIVALS bins, back corner) → Releases -->
	<hotspot name="nav_crate" style="navspot" url="../art/props/crate_glow.png"
		ath="172" atv="5" width="828" height="prop"
		tooltip="dig the crates — releases" zoomfov="55" panel="releases" />

	<!-- Cassette rack (tall tape shelf, back-right corner) → Catalog -->
	<hotspot name="nav_cassettes" style="navspot" url="../art/props/cassettes_glow.png"
		ath="138" atv="-12" width="499" height="prop"
		tooltip="tape wall — full catalog" zoomfov="50" panel="catalog" />

	<!-- Poster wall (bricks above the bins) → Artists -->
	<hotspot name="nav_posters" style="navspot" url="../art/props/posters_glow.png"
		ath="-175" atv="-25" width="830" height="prop"
		tooltip="poster wall — artists" zoomfov="60" panel="artists" />

	<!-- Desk buried in demo tapes (lamp + #1 CUSTOMER mug) → About -->
	<hotspot name="nav_desk" style="navspot" url="../art/props/desk_glow.png"
		ath="95" atv="15" width="1000" height="prop"
		tooltip="the desk — about us" zoomfov="60" panel="about" />

	<!-- Front glass door (OPEN sign) → Enter Store -->
	<hotspot name="nav_door" style="navspot" url="../art/props/door_glow.png"
		ath="44" atv="-3" width="389" height="prop"
		tooltip="come on in — store" zoomfov="60" panel="store" />

	<!-- Listening station (LISTEN HERE, headphones + turntable) → Music player -->
	<hotspot name="nav_listen" style="navspot" url="../art/props/listen_glow.png"
		ath="-88" atv="-6" width="728" height="prop"
		tooltip="put the headphones on" zoomfov="50" panel="player" />

	<!--
		Mail slot → Contact. Visible additive prop on the door's lower
		panel; declared after nav_door plus higher zorder so it wins the
		overlapping hover/click zone.
	-->
	<hotspot name="glow_nav_mailslot" type="image" keep="true" group="nav"
		url="../art/props/mailslot_glow.png" distorted="true"
		ath="43" atv="13" width="200" height="prop"
		alpha="0.0" enabled="false" zorder="11" />
	<hotspot name="nav_mailslot" type="image" keep="true" group="nav"
		url="../art/props/mailslot.png" distorted="true"
		ath="43" atv="13" width="140" height="prop" zorder="12"
		onover="prop_over();" onout="prop_out();" onclick="nav_go();"
		handcursor="true"
		tooltip="drop us a note" zoomfov="45" panel="contact" />

</krpano>
