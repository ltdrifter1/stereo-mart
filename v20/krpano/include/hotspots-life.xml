<krpano>

	<!--
		Ambient life + hidden discoveries.

		In-place animations use patches cropped from the master plate itself
		(pixel-perfect alignment, feathered edges — see make-patches.py) or
		additive light sprites; sheet props are only used for objects that
		do NOT exist in the painted plate (steam, ghost, stickers,
		mushroom), so nothing double-draws.

		Fan / platter spin need bake-level treatment (plate variants or a
		repaint with separated layers) and are deliberately not overlaid.
	-->

	<style name="lifespot"
		type="image" keep="true" group="life"
		distorted="true" enabled="false" zorder="5"
	/>

	<style name="eggspot"
		type="image" keep="true" group="egg"
		distorted="true" zorder="6" handcursor="true"
	/>

	<!-- ===== always-on loops ===== -->

	<!-- sleeping cat: plate patch, breathes; petting it counts as a find -->
	<hotspot name="life_cat" style="lifespot" url="../art/props/cat_patch.png"
		ath="-163.4" atv="23.9" width="510" height="322"
		enabled="true" handcursor="true"
		onclick="egg_found(cat, 'the shop cat (she stretched!)');" />

	<!-- coffee steam above the #1 CUSTOMER mug on the desk (additive) -->
	<hotspot name="life_steam" style="lifespot" url="../art/props/steam_a.png"
		ath="92" atv="12" width="70" height="prop" alpha="0.55" />

	<!-- warm pool of the desk lamp: additive sprite, rare single flicker -->
	<hotspot name="life_lamp" style="lifespot" url="../art/props/lamp_pool.png"
		ath="88" atv="5" width="210" height="prop"
		alpha="0.55" blendmode="add" />

	<action name="life_start">
		life_cat_breathe();
		life_steam_drift();
		life_lamp_flicker();
		egg_ghost_haunt();
	</action>

	<action name="life_cat_breathe">
		tween(hotspot[life_cat].scale, 1.015, 2.4, easeInOutSine,
			tween(hotspot[life_cat].scale, 1.0, 2.6, easeInOutSine, life_cat_breathe(); );
		);
	</action>

	<action name="life_steam_drift">
		tween(hotspot[life_steam].oy, -8, 2.6, easeInOutSine, );
		tween(hotspot[life_steam].alpha, 0.75, 2.6, easeInOutSine,
			tween(hotspot[life_steam].oy, 0, 2.6, easeInOutSine, );
			tween(hotspot[life_steam].alpha, 0.55, 2.6, easeInOutSine, life_steam_drift(); );
		);
	</action>

	<action name="life_lamp_flicker">
		delayedcall(lampflick, calc(25 + random * 50),
			tween(hotspot[life_lamp].alpha, 0.25, 0.06, default,
				tween(hotspot[life_lamp].alpha, 0.55, 0.10, default, life_lamp_flicker(); );
			);
		);
	</action>

	<!-- ===== hidden discoveries (tracked in js/discoveries.js) ===== -->

	<!-- tiny ghost: blips into the storage doorway for a moment, rarely;
	     clicking it while visible counts -->
	<hotspot name="egg_ghost" style="eggspot" url="../art/props/ghost.png"
		ath="109" atv="-5" width="150" height="prop"
		alpha="0.0" enabled="false"
		onclick="egg_found(ghost, 'the storage room ghost');" />

	<action name="egg_ghost_haunt">
		delayedcall(ghost, calc(90 + random * 200),
			set(hotspot[egg_ghost].enabled, true);
			tween(hotspot[egg_ghost].alpha, 0.8, 0.3, default,
				delayedcall(ghosthold, 1.4,
					set(hotspot[egg_ghost].enabled, false);
					tween(hotspot[egg_ghost].alpha, 0.0, 0.4, default, egg_ghost_haunt(); );
				);
			);
		);
	</action>

	<!-- stickers & tiny things hiding in the art -->
	<hotspot name="egg_rabbit" style="eggspot" url="../art/props/sticker_rabbit.png"
		ath="-114" atv="20" width="70" height="prop"
		onclick="egg_found(rabbit, 'the rabbit sticker');" />

	<hotspot name="egg_turtle" style="eggspot" url="../art/props/sticker_turtle.png"
		ath="-146" atv="19" width="88" height="prop"
		onclick="egg_found(turtle, 'the turtle sticker');" />

	<hotspot name="egg_mushroom" style="eggspot" url="../art/props/mushroom.png"
		ath="-53" atv="15" width="52" height="prop"
		onclick="egg_found(mushroom, 'a tiny mushroom');" />

</krpano>
