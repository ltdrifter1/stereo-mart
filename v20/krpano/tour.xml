<krpano version="1.22" title="STEREO-MART — Illustrated Record Shop">

	<!--
		STEREO-MART v20 entry point.
		One scene (the shop interior). All navigation lives inside the
		artwork as image hotspots; there is no DOM menu layer.
	-->

	<include url="include/view.xml" />
	<include url="include/actions.xml" />
	<include url="include/hotspots-nav.xml" />
	<include url="include/hotspots-life.xml" />
	<include url="include/panels.xml" />
	<include url="include/audio.xml" />

	<skin_settings design="flat" controls="false" fullscreen="false" thumbs="false" />

	<events name="boot" keep="true"
		onnewpano="start_idle_breathing(); life_start();"
		onclick="ambience_boot();"
	/>

	<scene name="shop" title="The Shop" autoload="true">
		<!--
			The tour currently loads the baked equirect master directly as a
			sphere image (works everywhere, no license needed to iterate).
			For launch, run the licensed krpanotools makepano on
			art/plates/pano-equirect-master.jpg and swap in the multires
			cube tiles below for faster first paint + sharper zoom:

			<image><cube url="panos/shop.tiles/pano_%s.jpg" multires="512,1024,2048,4096" /></image>
		-->
		<preview url="../art/plates/pano-equirect-lqip.jpg" />
		<image devices="desktop">
			<sphere url="../art/plates/pano-equirect-master.jpg" />
		</image>
		<image devices="tablet|mobile">
			<sphere url="../art/plates/pano-equirect-mobile.jpg" />
		</image>
	</scene>

</krpano>
